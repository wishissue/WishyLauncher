<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is just the dark backdrop (its icon is transparent); the app then shows the Material 3 loading indicator. -->
    <style name="Theme.LiteTV" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#080B12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
    </style>
</resources>
