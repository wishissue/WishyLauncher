{
  "$schema": "../../schema/wishy-theme.schema.v1.json",
  "schemaVersion": 1,
  "id": "wishy",
  "name": "Wishy",
  "version": "3.0.0",
  "author": "Wishy Launcher contributors",
  "description": "The Wishy Browser look on your TV. Brand blue, Plus Jakarta Sans, soft rounded shapes, a glass shelf for your apps and a blue glow on the focused banner. Light and dark wallpapers included, and you can swap them for your own.",
  "license": "GPL-3.0-only",
  "defaultColorScheme": "system",
  "credits": [
    {
      "file": "assets/fonts/PlusJakartaSans-Regular.ttf",
      "title": "Plus Jakarta Sans Regular",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-Medium.ttf",
      "title": "Plus Jakarta Sans Medium",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-SemiBold.ttf",
      "title": "Plus Jakarta Sans SemiBold",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-Bold.ttf",
      "title": "Plus Jakarta Sans Bold",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/ui/wallpaper-dark.webp",
      "title": "Wishy wallpaper, dark",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-wallpapers.py in the launcher repository."
    },
    {
      "file": "assets/ui/wallpaper-light.webp",
      "title": "Wishy wallpaper, light",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-wallpapers.py in the launcher repository."
    },
    {
      "file": "assets/art/default.png",
      "title": "Placeholder cover",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-wallpapers.py in the launcher repository."
    }
  ],
  "colorSchemes": {
    "light": {
      "background": "#E6F1FF",
      "surface": "#FFFFFF",
      "surfaceVariant": "#DAE5F6",
      "onSurface": "#101828",
      "onSurfaceMuted": "#46556C",
      "primary": "#0166FF",
      "onPrimary": "#FFFFFF",
      "accent": "#946200",
      "outline": "#C3D4EE",
      "scrim": "#660B1B33",
      "custom": {
        "glass": "#B8FFFFFF",
        "glassEdge": "#99FFFFFF"
      }
    },
    "dark": {
      "background": "#080B12",
      "surface": "#111725",
      "surfaceVariant": "#182235",
      "onSurface": "#F1F4FB",
      "onSurfaceMuted": "#B0BCD0",
      "primary": "#66A3FF",
      "onPrimary": "#002266",
      "accent": "#F4C66A",
      "outline": "#303B4F",
      "scrim": "#99000000",
      "custom": {
        "glass": "#80111725",
        "glassEdge": "#26FFFFFF"
      }
    }
  },
  "fonts": {
    "regular": {
      "file": "assets/fonts/PlusJakartaSans-Regular.ttf"
    },
    "medium": {
      "file": "assets/fonts/PlusJakartaSans-Medium.ttf"
    },
    "semibold": {
      "file": "assets/fonts/PlusJakartaSans-SemiBold.ttf"
    },
    "bold": {
      "file": "assets/fonts/PlusJakartaSans-Bold.ttf"
    }
  },
  "textStyles": {
    "clock": {
      "font": "semibold",
      "size": 96,
      "color": "@onSurface",
      "letterSpacing": -3,
      "shadow": {
        "color": "@background/55",
        "dy": 2,
        "blur": 16
      }
    },
    "date": {
      "font": "medium",
      "size": 30,
      "color": "@onSurfaceMuted",
      "shadow": {
        "color": "@background/55",
        "dy": 1,
        "blur": 10
      }
    },
    "title": {
      "font": "bold",
      "size": 50,
      "color": "@onSurface",
      "letterSpacing": -1,
      "maxLines": 1,
      "shadow": {
        "color": "@background/55",
        "dy": 2,
        "blur": 14
      }
    },
    "tab": {
      "font": "semibold",
      "size": 28,
      "color": "@onSurfaceMuted",
      "maxLines": 1
    },
    "brand": {
      "font": "bold",
      "size": 34,
      "color": "@primary",
      "letterSpacing": -0.5,
      "align": "end",
      "maxLines": 1
    }
  },
  "background": {
    "color": "@background",
    "image": "assets/ui/wallpaper-dark.webp",
    "fit": "crop",
    "dim": 0.0,
    "userWallpaper": "allowed"
  },
  "cardStyles": {
    "banner": {
      "aspect": "16:9",
      "shape": {
        "kind": "rounded",
        "radius": 28
      },
      "fill": "@surface",
      "border": {
        "width": 1,
        "color": "@outline"
      },
      "artwork": {
        "source": "auto",
        "fit": "crop",
        "iconSize": 110,
        "placeholderFill": "@surfaceVariant",
        "themeArt": true
      },
      "label": {
        "position": "none"
      },
      "idle": {
        "scale": 1.0,
        "alpha": 0.96
      },
      "focused": {
        "scale": 1.09,
        "alpha": 1.0,
        "shadow": {
          "color": "@primary/55",
          "dy": 14,
          "blur": 44
        },
        "indicator": {
          "kind": "ring",
          "color": "@primary",
          "width": 4,
          "gap": 5
        }
      },
      "moving": {
        "scale": 1.13,
        "shadow": {
          "color": "#99000000",
          "dy": 18,
          "blur": 40
        },
        "indicator": {
          "kind": "ring",
          "color": "@accent",
          "width": 6,
          "gap": 6,
          "blink": true,
          "blinkMillis": 500
        }
      }
    }
  },
  "motion": {
    "focusMillis": 60,
    "scrollMillis": 100,
    "easing": "decelerate",
    "screenTransition": "none"
  },
  "screens": {
    "home": {
      "root": {
        "type": "stack",
        "children": [
          {
            "type": "shape",
            "id": "shelf",
            "shape": {
              "kind": "rounded",
              "radius": 44
            },
            "fill": "@custom.glass",
            "border": {
              "width": 1,
              "color": "@custom.glassEdge"
            },
            "frame": {
              "x": "2.5%",
              "y": "61.5%",
              "w": "95%",
              "h": "36.5%"
            }
          },
          {
            "type": "clock",
            "id": "clock",
            "style": "clock",
            "showWhen": "clockEnabled",
            "frame": {
              "x": "5%",
              "y": "6%"
            }
          },
          {
            "type": "date",
            "id": "date",
            "style": "date",
            "showWhen": "dateEnabled",
            "frame": {
              "x": "5%",
              "y": "19.5%"
            }
          },
          {
            "type": "text",
            "id": "wordmark",
            "text": "Wishy",
            "style": "brand",
            "frame": {
              "x": "70%",
              "y": "7%",
              "w": "25%"
            }
          },
          {
            "type": "focusedAppName",
            "id": "focusName",
            "style": "title",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "5%",
              "y": "42.5%"
            }
          },
          {
            "type": "sections",
            "id": "tabs",
            "arrangement": "tabs",
            "style": "tab",
            "gap": 40,
            "selectedIndicator": {
              "kind": "underline",
              "color": "@primary",
              "width": 5,
              "gap": 8
            },
            "frame": {
              "x": "5%",
              "y": "53%",
              "w": "90%",
              "h": "6%"
            }
          },
          {
            "type": "apps",
            "id": "apps",
            "arrangement": "rail",
            "card": "banner",
            "itemWidth": 360,
            "gap": 30,
            "scroll": "edge",
            "focusScope": "section",
            "frame": {
              "x": 0,
              "y": "64%",
              "w": "100%",
              "h": "32%"
            },
            "padding": {
              "left": "5%",
              "right": "5%"
            }
          }
        ]
      }
    }
  },
  "overrides": [
    {
      "when": {
        "colorScheme": "light"
      },
      "merge": {
        "background": {
          "image": "assets/ui/wallpaper-light.webp"
        }
      }
    },
    {
      "when": {
        "reducedMotion": true
      },
      "merge": {
        "motion": {
          "focusMillis": 0,
          "scrollMillis": 0
        }
      }
    }
  ]
}
