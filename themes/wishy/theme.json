{
  "$schema": "../../schema/wishy-theme.schema.v1.json",
  "schemaVersion": 1,
  "id": "wishy",
  "name": "Wishy",
  "version": "4.1.0",
  "author": "Wishy Launcher contributors",
  "description": "Clean, console-style home. A big title for the focused app, one calm row of square tiles, a bold clock, and hints along the bottom. Every Display setting (corners, size, spacing, labels, accent, wallpaper, clock, date) applies. Sections are off by default: just one row of all your apps.",
  "license": "GPL-3.0-only",
  "defaultColorScheme": "system",
  "credits": [
    {
      "file": "assets/fonts/PlusJakartaSans-Regular.ttf",
      "title": "Plus Jakarta Sans Regular",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-Medium.ttf",
      "title": "Plus Jakarta Sans Medium",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-SemiBold.ttf",
      "title": "Plus Jakarta Sans SemiBold",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-Bold.ttf",
      "title": "Plus Jakarta Sans Bold",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/BagelFatOne-Regular.ttf",
      "title": "Bagel Fat One",
      "author": "The Bagel Fat Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/JAMO-TYPEFACE/BagelFat"
    },
    {
      "file": "assets/ui/wallpaper-dark.webp",
      "title": "Wishy wallpaper, dark",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-wallpapers.py in the launcher repository."
    },
    {
      "file": "assets/ui/wallpaper-light.webp",
      "title": "Wishy wallpaper, light",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-wallpapers.py in the launcher repository."
    },
    {
      "file": "assets/art/default.png",
      "title": "Placeholder cover",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-wallpapers.py in the launcher repository."
    }
  ],
  "colorSchemes": {
    "light": {
      "background": "#E6F1FF",
      "surface": "#FFFFFF",
      "surfaceVariant": "#DAE5F6",
      "onSurface": "#101828",
      "onSurfaceMuted": "#46556C",
      "primary": "#0166FF",
      "onPrimary": "#FFFFFF",
      "accent": "#946200",
      "outline": "#C3D4EE",
      "scrim": "#660B1B33",
      "custom": {
        "glass": "#B8FFFFFF",
        "glassEdge": "#99FFFFFF",
        "ring": "#FFFFFF"
      }
    },
    "dark": {
      "background": "#080B12",
      "surface": "#111725",
      "surfaceVariant": "#182235",
      "onSurface": "#F1F4FB",
      "onSurfaceMuted": "#B0BCD0",
      "primary": "#66A3FF",
      "onPrimary": "#002266",
      "accent": "#F4C66A",
      "outline": "#303B4F",
      "scrim": "#99000000",
      "custom": {
        "glass": "#80111725",
        "glassEdge": "#26FFFFFF",
        "ring": "#FFFFFF"
      }
    }
  },
  "fonts": {
    "regular": {
      "file": "assets/fonts/PlusJakartaSans-Regular.ttf"
    },
    "medium": {
      "file": "assets/fonts/PlusJakartaSans-Medium.ttf"
    },
    "semibold": {
      "file": "assets/fonts/PlusJakartaSans-SemiBold.ttf"
    },
    "bold": {
      "file": "assets/fonts/PlusJakartaSans-Bold.ttf"
    },
    "display": {
      "file": "assets/fonts/BagelFatOne-Regular.ttf"
    }
  },
  "textStyles": {
    "clock": {
      "font": "display",
      "size": 72,
      "color": "@onSurface",
      "letterSpacing": 1,
      "align": "end",
      "maxLines": 1,
      "shadow": {
        "color": "@background/55",
        "dy": 2,
        "blur": 16
      }
    },
    "date": {
      "font": "semibold",
      "size": 26,
      "color": "@onSurfaceMuted",
      "align": "end",
      "maxLines": 1,
      "shadow": {
        "color": "@background/55",
        "dy": 1,
        "blur": 10
      }
    },
    "title": {
      "font": "display",
      "size": 104,
      "color": "@onSurface",
      "maxLines": 1,
      "letterSpacing": 0,
      "shadow": {
        "color": "@background/55",
        "dy": 3,
        "blur": 20
      }
    },
    "tab": {
      "font": "semibold",
      "size": 24,
      "color": "@onSurfaceMuted",
      "uppercase": true,
      "letterSpacing": 1.5,
      "maxLines": 1
    },
    "label": {
      "font": "semibold",
      "size": 24,
      "color": "@onSurface",
      "maxLines": 1,
      "shadow": {
        "color": "@background/55",
        "dy": 1,
        "blur": 8
      }
    },
    "hint": {
      "font": "semibold",
      "size": 22,
      "color": "@onSurfaceMuted",
      "uppercase": true,
      "letterSpacing": 1,
      "maxLines": 1
    },
    "hintKey": {
      "font": "bold",
      "size": 22,
      "color": "@primary",
      "uppercase": true,
      "letterSpacing": 1,
      "maxLines": 1
    },
    "count": {
      "font": "semibold",
      "size": 24,
      "color": "@onSurfaceMuted",
      "letterSpacing": 1,
      "maxLines": 1,
      "shadow": {
        "color": "@background/55",
        "dy": 1,
        "blur": 8
      }
    }
  },
  "background": {
    "color": "@background",
    "image": "assets/ui/wallpaper-dark.webp",
    "fit": "crop",
    "dim": 0.18,
    "userWallpaper": "allowed"
  },
  "cardStyles": {
    "tile": {
      "aspect": "1:1",
      "shape": {
        "kind": "rounded",
        "radius": 28
      },
      "fill": "@surface",
      "artwork": {
        "source": "auto",
        "fit": "crop",
        "iconSize": "58%",
        "placeholderFill": "@surfaceVariant",
        "themeArt": true
      },
      "label": {
        "position": "below",
        "style": "label",
        "gap": 14
      },
      "idle": {
        "scale": 1.0,
        "alpha": 0.92
      },
      "focused": {
        "scale": 1.1,
        "alpha": 1.0,
        "shadow": {
          "color": "#80000000",
          "dy": 18,
          "blur": 40
        },
        "indicator": {
          "kind": "ring",
          "color": "@custom.ring",
          "width": 5,
          "gap": 5
        }
      },
      "moving": {
        "scale": 1.14,
        "shadow": {
          "color": "#99000000",
          "dy": 20,
          "blur": 44
        },
        "indicator": {
          "kind": "ring",
          "color": "@accent",
          "width": 6,
          "gap": 6,
          "blink": true,
          "blinkMillis": 500
        }
      }
    }
  },
  "motion": {
    "focusMillis": 60,
    "scrollMillis": 100,
    "easing": "decelerate",
    "screenTransition": "none"
  },
  "screens": {
    "home": {
      "root": {
        "type": "stack",
        "children": [
          {
            "type": "sections",
            "id": "tabs",
            "arrangement": "tabs",
            "style": "tab",
            "gap": 44,
            "selectedIndicator": {
              "kind": "underline",
              "color": "@primary",
              "width": 4,
              "gap": 8
            },
            "frame": {
              "x": "5%",
              "y": "5.5%",
              "w": "55%",
              "h": "5%"
            }
          },
          {
            "type": "statusIcons",
            "id": "status",
            "showWhen": "statusBarEnabled",
            "iconSize": 30,
            "gap": 6,
            "color": "@onSurface",
            "focusFill": "@onSurface/20",
            "frame": {
              "x": "95%",
              "y": "3%",
              "anchor": "topEnd"
            }
          },
          {
            "type": "clock",
            "id": "clock",
            "style": "clock",
            "showWhen": "clockEnabled",
            "frame": {
              "x": "95%",
              "y": "9.5%",
              "anchor": "topEnd",
              "w": "35%"
            }
          },
          {
            "type": "date",
            "id": "date",
            "style": "date",
            "showWhen": "dateEnabled",
            "frame": {
              "x": "95%",
              "y": "20%",
              "anchor": "topEnd",
              "w": "35%"
            }
          },
          {
            "type": "focusedAppName",
            "id": "focusName",
            "style": "title",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "5%",
              "y": "27%",
              "w": "90%"
            }
          },
          {
            "type": "text",
            "id": "position",
            "bind": "focusedPosition",
            "style": "count",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "5%",
              "y": "45.5%",
              "w": "40%"
            }
          },
          {
            "type": "apps",
            "id": "apps",
            "arrangement": "rail",
            "card": "tile",
            "itemWidth": 250,
            "gap": 34,
            "scroll": "edge",
            "wrap": true,
            "focusScope": "section",
            "frame": {
              "x": 0,
              "y": "52%",
              "w": "100%",
              "h": "38%"
            },
            "padding": {
              "left": "5%",
              "right": "5%"
            }
          }
        ]
      }
    }
  },
  "overrides": [
    {
      "when": {
        "colorScheme": "light"
      },
      "merge": {
        "background": {
          "image": "assets/ui/wallpaper-light.webp",
          "dim": 0.0
        }
      }
    },
    {
      "when": {
        "reducedMotion": true
      },
      "merge": {
        "motion": {
          "focusMillis": 0,
          "scrollMillis": 0
        }
      }
    }
  ],
  "chrome": {
    "statusBar": "theme"
  }
}
