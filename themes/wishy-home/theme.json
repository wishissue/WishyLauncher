{
  "$schema": "../../schema/wishy-theme.schema.v1.json",
  "schemaVersion": 1,
  "id": "wishy-home",
  "name": "Wishy Home",
  "version": "1.0.0",
  "author": "Wishy Launcher contributors",
  "description": "The default look. Flat, calm and readable from the sofa: the same colours as Settings, one row of wide banner tiles, the name of the selected app, and a clock. Every Display setting applies (corners, size, spacing, labels, accent, wallpaper, clock, date, status bar, sections, app order).",
  "license": "GPL-3.0-only",
  "defaultColorScheme": "system",
  "credits": [
    {
      "file": "assets/fonts/PlusJakartaSans-Regular.ttf",
      "title": "Plus Jakarta Sans Regular",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-Medium.ttf",
      "title": "Plus Jakarta Sans Medium",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-SemiBold.ttf",
      "title": "Plus Jakarta Sans SemiBold",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    },
    {
      "file": "assets/fonts/PlusJakartaSans-Bold.ttf",
      "title": "Plus Jakarta Sans Bold",
      "author": "The Plus Jakarta Sans Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/tokotype/PlusJakartaSans"
    }
  ],
  "colorSchemes": {
    "light": {
      "background": "#E6F1FF",
      "surface": "#FFFFFF",
      "surfaceVariant": "#DCE7F8",
      "onSurface": "#101828",
      "onSurfaceMuted": "#536176",
      "primary": "#1560D4",
      "onPrimary": "#FFFFFF",
      "accent": "#946200",
      "outline": "#D4DEED",
      "scrim": "#660B1B33",
      "custom": {
        "ring": "#1560D4"
      }
    },
    "dark": {
      "background": "#080B12",
      "surface": "#111725",
      "surfaceVariant": "#182235",
      "onSurface": "#F1F4FB",
      "onSurfaceMuted": "#B0BCD0",
      "primary": "#A8C8FF",
      "onPrimary": "#082C63",
      "accent": "#F4C66A",
      "outline": "#303B4F",
      "scrim": "#99000000",
      "custom": {
        "ring": "#A8C8FF"
      }
    }
  },
  "fonts": {
    "regular": {
      "file": "assets/fonts/PlusJakartaSans-Regular.ttf"
    },
    "medium": {
      "file": "assets/fonts/PlusJakartaSans-Medium.ttf"
    },
    "semibold": {
      "file": "assets/fonts/PlusJakartaSans-SemiBold.ttf"
    },
    "bold": {
      "file": "assets/fonts/PlusJakartaSans-Bold.ttf"
    }
  },
  "textStyles": {
    "clock": {
      "font": "bold",
      "size": 56,
      "color": "@onSurface",
      "align": "end",
      "maxLines": 1
    },
    "date": {
      "font": "medium",
      "size": 24,
      "color": "@onSurfaceMuted",
      "align": "end",
      "maxLines": 1
    },
    "title": {
      "font": "bold",
      "size": 72,
      "color": "@onSurface",
      "maxLines": 1
    },
    "tab": {
      "font": "semibold",
      "size": 24,
      "color": "@onSurfaceMuted",
      "maxLines": 1
    },
    "label": {
      "font": "semibold",
      "size": 22,
      "color": "@onSurface",
      "maxLines": 1
    },
    "count": {
      "font": "medium",
      "size": 22,
      "color": "@onSurfaceMuted",
      "maxLines": 1
    }
  },
  "background": {
    "color": "@background",
    "userWallpaper": "allowed"
  },
  "cardStyles": {
    "tile": {
      "aspect": "16:9",
      "shape": {
        "kind": "rounded",
        "radius": 20
      },
      "fill": "@surface",
      "border": {
        "width": 1,
        "color": "@outline"
      },
      "artwork": {
        "source": "auto",
        "fit": "crop",
        "iconSize": "46%",
        "placeholderFill": "@surfaceVariant"
      },
      "label": {
        "position": "below",
        "style": "label",
        "gap": 12
      },
      "idle": {
        "scale": 1.0,
        "alpha": 0.94
      },
      "focused": {
        "scale": 1.07,
        "alpha": 1.0,
        "shadow": {
          "color": "#66000000",
          "dy": 12,
          "blur": 28
        },
        "indicator": {
          "kind": "ring",
          "color": "@primary",
          "width": 4,
          "gap": 4
        }
      },
      "moving": {
        "scale": 1.1,
        "shadow": {
          "color": "#80000000",
          "dy": 14,
          "blur": 32
        },
        "indicator": {
          "kind": "ring",
          "color": "@accent",
          "width": 5,
          "gap": 5,
          "blink": true,
          "blinkMillis": 500
        }
      }
    }
  },
  "motion": {
    "focusMillis": 60,
    "scrollMillis": 100,
    "easing": "decelerate",
    "screenTransition": "none"
  },
  "screens": {
    "home": {
      "root": {
        "type": "stack",
        "children": [
          {
            "type": "sections",
            "id": "tabs",
            "arrangement": "tabs",
            "style": "tab",
            "gap": 40,
            "selectedIndicator": {
              "kind": "underline",
              "color": "@primary",
              "width": 4,
              "gap": 8
            },
            "frame": {
              "x": "5%",
              "y": "5.5%",
              "w": "55%",
              "h": "5%"
            }
          },
          {
            "type": "statusIcons",
            "id": "status",
            "showWhen": "statusBarEnabled",
            "iconSize": 30,
            "gap": 6,
            "color": "@onSurface",
            "focusFill": "@onSurface/20",
            "frame": {
              "x": "95%",
              "y": "3%",
              "anchor": "topEnd"
            }
          },
          {
            "type": "clock",
            "id": "clock",
            "style": "clock",
            "showWhen": "clockEnabled",
            "frame": {
              "x": "95%",
              "y": "9.5%",
              "anchor": "topEnd",
              "w": "35%"
            }
          },
          {
            "type": "date",
            "id": "date",
            "style": "date",
            "showWhen": "dateEnabled",
            "frame": {
              "x": "95%",
              "y": "19%",
              "anchor": "topEnd",
              "w": "35%"
            }
          },
          {
            "type": "focusedAppName",
            "id": "focusName",
            "style": "title",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "5%",
              "y": "30%",
              "w": "90%"
            }
          },
          {
            "type": "text",
            "id": "position",
            "bind": "focusedPosition",
            "style": "count",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "5%",
              "y": "43%",
              "w": "40%"
            }
          },
          {
            "type": "apps",
            "id": "apps",
            "arrangement": "rail",
            "card": "tile",
            "itemWidth": 340,
            "gap": 30,
            "scroll": "edge",
            "wrap": true,
            "focusScope": "section",
            "frame": {
              "x": 0,
              "y": "54%",
              "w": "100%",
              "h": "36%"
            },
            "padding": {
              "left": "5%",
              "right": "5%"
            }
          }
        ]
      }
    }
  },
  "overrides": [
    {
      "when": {
        "reducedMotion": true
      },
      "merge": {
        "motion": {
          "focusMillis": 0,
          "scrollMillis": 0
        }
      }
    }
  ],
  "chrome": {
    "statusBar": "theme"
  }
}
