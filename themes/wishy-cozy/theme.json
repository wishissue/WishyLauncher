{
  "$schema": "../../schema/wishy-theme.schema.v1.json",
  "schemaVersion": 1,
  "id": "wishy-cozy",
  "name": "Wishy Cozy",
  "version": "1.0.0",
  "author": "Wishy Launcher contributors",
  "description": "A warm, soft bento home: a greeting and clock card on the left, the focused app on the right, and your apps below as a mix of big banner tiles and small square icons.",
  "license": "GPL-3.0-only",
  "defaultColorScheme": "system",
  "credits": [
    {
      "file": "assets/fonts/BagelFatOne-Regular.ttf",
      "title": "Bagel Fat One",
      "author": "The Bagel Fat Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/JAMO-TYPEFACE/BagelFat"
    },
    {
      "file": "assets/fonts/VarelaRound-Regular.ttf",
      "title": "Varela Round",
      "author": "The Varela Round Project Authors",
      "license": "OFL-1.1",
      "source": "https://github.com/alefalefalef/Varela-Round-Hebrew"
    },
    {
      "file": "assets/ui/wallpaper-light.webp",
      "title": "Cozy wallpaper, light",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-cozy-wallpapers.py."
    },
    {
      "file": "assets/ui/wallpaper-dark.webp",
      "title": "Cozy wallpaper, dark",
      "author": "Wishy Launcher contributors",
      "license": "GPL-3.0-only",
      "notes": "Drawn from scratch by tools/gen-cozy-wallpapers.py."
    }
  ],
  "colorSchemes": {
    "light": {
      "background": "#FFF4E6",
      "surface": "#FFFFFF",
      "surfaceVariant": "#F6E3CF",
      "onSurface": "#3B2A20",
      "onSurfaceMuted": "#7A6354",
      "primary": "#E2693A",
      "onPrimary": "#FFFFFF",
      "accent": "#B86A00",
      "outline": "#EAD3BC",
      "scrim": "#66301F10",
      "custom": {
        "panel": "#CCFFFFFF",
        "panelEdge": "#33B8754A"
      }
    },
    "dark": {
      "background": "#1E1612",
      "surface": "#2E221B",
      "surfaceVariant": "#3B2C23",
      "onSurface": "#FBEBDD",
      "onSurfaceMuted": "#C4A998",
      "primary": "#FFA66B",
      "onPrimary": "#3A1A08",
      "accent": "#F5C76A",
      "outline": "#4A372B",
      "scrim": "#99000000",
      "custom": {
        "panel": "#992E221B",
        "panelEdge": "#26FFD9B8"
      }
    }
  },
  "fonts": {
    "display": {
      "file": "assets/fonts/BagelFatOne-Regular.ttf"
    },
    "body": {
      "file": "assets/fonts/VarelaRound-Regular.ttf"
    }
  },
  "textStyles": {
    "greeting": {
      "font": "body",
      "size": 30,
      "color": "@onSurfaceMuted",
      "maxLines": 1
    },
    "clock": {
      "font": "display",
      "size": 118,
      "color": "@onSurface",
      "maxLines": 1
    },
    "date": {
      "font": "body",
      "size": 34,
      "color": "@primary",
      "maxLines": 1
    },
    "section": {
      "font": "body",
      "size": 28,
      "color": "@onSurfaceMuted",
      "maxLines": 1
    },
    "name": {
      "font": "display",
      "size": 58,
      "color": "@onSurface",
      "maxLines": 1
    },
    "meta": {
      "font": "body",
      "size": 26,
      "color": "@onSurfaceMuted",
      "maxLines": 1
    },
    "label": {
      "font": "body",
      "size": 26,
      "color": "#FFFFFF",
      "maxLines": 1
    }
  },
  "background": {
    "color": "@background",
    "image": "assets/ui/wallpaper-dark.webp",
    "fit": "crop",
    "userWallpaper": "allowed"
  },
  "cardStyles": {
    "small": {
      "aspect": "4:3",
      "shape": {
        "kind": "rounded",
        "radius": 36
      },
      "fill": "@surface",
      "shadow": {
        "color": "#22000000",
        "dy": 8,
        "blur": 24
      },
      "artwork": {
        "source": "icon",
        "fit": "crop",
        "placeholderFill": "@surfaceVariant",
        "iconSize": "44%"
      },
      "label": {
        "position": "focusedOnly",
        "style": "label"
      },
      "idle": {
        "scale": 1.0,
        "alpha": 1.0
      },
      "focused": {
        "scale": 1.04,
        "alpha": 1.0,
        "shadow": {
          "color": "@primary/40",
          "dy": 14,
          "blur": 36
        },
        "indicator": {
          "kind": "ring",
          "color": "@primary",
          "width": 5,
          "gap": 5
        }
      }
    },
    "wide": {
      "aspect": "2:1",
      "shape": {
        "kind": "rounded",
        "radius": 36
      },
      "fill": "@surface",
      "shadow": {
        "color": "#22000000",
        "dy": 8,
        "blur": 24
      },
      "artwork": {
        "source": "auto",
        "fit": "crop",
        "placeholderFill": "@surfaceVariant",
        "iconSize": "30%"
      },
      "label": {
        "position": "focusedOnly",
        "style": "label"
      },
      "idle": {
        "scale": 1.0,
        "alpha": 1.0
      },
      "focused": {
        "scale": 1.04,
        "alpha": 1.0,
        "shadow": {
          "color": "@primary/40",
          "dy": 14,
          "blur": 36
        },
        "indicator": {
          "kind": "ring",
          "color": "@primary",
          "width": 5,
          "gap": 5
        }
      }
    }
  },
  "motion": {
    "focusMillis": 60,
    "scrollMillis": 100,
    "easing": "decelerate",
    "screenTransition": "none"
  },
  "chrome": {
    "statusBar": "theme"
  },
  "screens": {
    "home": {
      "root": {
        "type": "stack",
        "children": [
          {
            "type": "shape",
            "id": "greetPanel",
            "shape": {
              "kind": "rounded",
              "radius": 48
            },
            "fill": "@custom.panel",
            "border": {
              "width": 1,
              "color": "@custom.panelEdge"
            },
            "frame": {
              "x": "2.5%",
              "y": "4%",
              "w": "39%",
              "h": "29%"
            }
          },
          {
            "type": "text",
            "id": "greeting",
            "text": "Make yourself at home",
            "style": "greeting",
            "frame": {
              "x": "5%",
              "y": "6.5%"
            }
          },
          {
            "type": "clock",
            "id": "clock",
            "style": "clock",
            "showWhen": "clockEnabled",
            "frame": {
              "x": "4.8%",
              "y": "10.5%"
            }
          },
          {
            "type": "date",
            "id": "date",
            "style": "date",
            "showWhen": "dateEnabled",
            "frame": {
              "x": "5%",
              "y": "25%"
            }
          },
          {
            "type": "shape",
            "id": "focusPanel",
            "shape": {
              "kind": "rounded",
              "radius": 48
            },
            "fill": "@custom.panel",
            "border": {
              "width": 1,
              "color": "@custom.panelEdge"
            },
            "frame": {
              "x": "44%",
              "y": "4%",
              "w": "53.5%",
              "h": "29%"
            }
          },
          {
            "type": "focusedAppName",
            "id": "focusName",
            "style": "name",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "46.5%",
              "y": "11%",
              "w": "42%"
            }
          },
          {
            "type": "text",
            "id": "count",
            "bind": "focusedPosition",
            "style": "meta",
            "showWhen": "hasFocusedApp",
            "frame": {
              "x": "46.5%",
              "y": "22.5%",
              "w": "20%"
            }
          },
          {
            "type": "statusIcons",
            "id": "status",
            "showWhen": "statusBarEnabled",
            "iconSize": 30,
            "gap": 6,
            "color": "@onSurface",
            "focusFill": "@primary/25",
            "frame": {
              "x": "95%",
              "y": "6.5%",
              "anchor": "topEnd"
            }
          },
          {
            "type": "sections",
            "id": "sections",
            "arrangement": "tabs",
            "style": "section",
            "gap": 18,
            "selectedIndicator": {
              "kind": "underline",
              "color": "@primary",
              "width": 4,
              "gap": 4
            },
            "frame": {
              "x": "3%",
              "y": "35.5%",
              "w": "94%"
            }
          },
          {
            "type": "apps",
            "id": "apps",
            "arrangement": "bento",
            "card": "small",
            "bigCard": "wide",
            "columns": 5,
            "gap": 22,
            "frame": {
              "x": "1.5%",
              "y": "41%",
              "w": "97%",
              "h": "58%"
            }
          }
        ]
      }
    }
  },
  "overrides": [
    {
      "when": {
        "colorScheme": "light"
      },
      "merge": {
        "background": {
          "image": "assets/ui/wallpaper-light.webp"
        }
      }
    },
    {
      "when": {
        "reducedMotion": true
      },
      "merge": {
        "motion": {
          "focusMillis": 0,
          "scrollMillis": 0
        }
      }
    }
  ]
}
